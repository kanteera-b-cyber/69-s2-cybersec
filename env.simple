services:
  db:
    image: postgres:16-alpine
    container_name: 69-s2-db
    ports:
      - "54321:5432"
    environment:
      - POSTGRES_PASSWORD=<CHANGE-ME>
      - POSTGRES_USER=<USER>
      - POSTGRES_DB=<USER>

  admin:
    image: dpage/pgadmin4:8.8
    container_name: 69-s2-admin
    ports:
      - "8082:80"
    environment:
      - PGADMIN_DEFAULT_EMAIL=<EMAIL>
      - PGADMIN_DEFAULT_PASSWORD=<CHANGE-ME>
