# REST

##VARIABLES
@ADMIN_EMAIL = {{$dotenv ADMIN_EMAIL}}
@ADMIN_PASSWORD = {{$dotenv ADMIN_PASSWORD}}
@ADMIN_FIRSTNAME = {{$dotenv ADMIN_FIRSTNAME}}
@ADMIN_LASTNAME = {{$dotenv ADMIN_LASTNAME}}
@ADMIN_RESET_TOKEN = {{$dotenv ADMIN_RESET_TOKEN}}
@ADMIN_JWT = {{$dotenv ADMIN_JWT}}
@USER_EMAIL = {{$dotenv USER_EMAIL}}
@USER_PASSWORD = {{$dotenv USER_PASSWORD}}
@USER_USERNAME = {{$dotenv USER_USERNAME}}
@USER_RESET_CODE = {{$dotenv USER_RESET_CODE}}
@USER_JWT = {{$dotenv USER_JWT}}


## 1.Admin
### 1.1 Login
POST http://localhost:1337/admin/login
Content-Type: application/json

{
    "email": "{{ADMIN_EMAIL}}",
    "password": "{{ADMIN_PASSWORD}}",
    "rememberMe": false
}


### 1.2 Register (Admin) one time for first time
POST http://localhost:1337/admin/register-admin
Content-Type: application/json

{
    "firstname": "{{ADMIN_FIRSTNAME}}",
    "lastname": "{{ADMIN_LASTNAME}}",
    "email": "{{ADMIN_EMAIL}}",
    "password": "{{ADMIN_PASSWORD}}"
}


### 1.3 Forget Password
POST http://localhost:1337/admin/forgot-password
Content-Type: application/json

{
    "email": "{{ADMIN_EMAIL}}"
}


### 1.3.1 Reset Password
# เอา code จาก response ของ Forgot Password มาใส่ที่ resetPasswordToken (ดู log server ได้เช่นกัน)
POST http://localhost:1337/admin/reset-password
Content-Type: application/json

{
    "resetPasswordToken": "{{ADMIN_RESET_TOKEN}}",
    "password": "{{ADMIN_PASSWORD}}",
    "passwordConfirmation": "{{ADMIN_PASSWORD}}"
}


### 1.4 Profile
GET http://localhost:1337/admin/users/me
Authorization: Bearer {{ADMIN_JWT}}
Content-Type: application/json


## 2.User
### 2.1 Login (User)
POST http://localhost:1337/api/auth/local
Content-Type: application/json

{
    "identifier": "{{USER_EMAIL}}",
    "password": "{{USER_PASSWORD}}"
}

### 2.2 Register (User) one time for first time
POST http://localhost:1337/api/auth/local/register
Content-Type: application/json

{
    "username": "{{USER_USERNAME}}",
    "email": "{{USER_EMAIL}}",
    "password": "{{USER_PASSWORD}}"
}

### 2.3 Forgot Password
POST http://localhost:1337/api/auth/forgot-password
Content-Type: application/json

{
    "email": "{{USER_EMAIL}}"
}


### 2.3.1 Reset Password
# เอา code จาก response ของ Forgot Password มาใส่ที่ code (ดู log server ได้เช่นกัน)
POST http://localhost:1337/api/auth/reset-password
Content-Type: application/json

{
    "password": "{{USER_PASSWORD}}",
    "passwordConfirmation": "{{USER_PASSWORD}}",
    "code": "{{USER_RESET_CODE}}"
}


### 2.4 Profile
GET http://localhost:1337/api/users/me
Authorization: Bearer {{USER_JWT}}
Content-Type: application/json
