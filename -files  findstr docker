services:
  db:
    image: postgres:16-alpine
    container_name: 69-s2-db
    ports:
      - "54321:5432"
    environment:
      - POSTGRES_PASSWORD=123456
      - POSTGRES_USER=kanteera
      - POSTGRES_DB=kanteera

  admin:
    image: dpage/pgadmin4:8.8
    container_name: 69-s2-admin
    ports:
      - "8082:80"
    environment:
      - PGADMIN_DEFAULT_EMAIL=kanteera-b@rmutp.ac.th
      - PGADMIN_DEFAULT_PASSWORD=123456
      
  app:
    image: prawee/strapi
    container_name: 69-s2-app
    restart: always
    depends_on:
      - db
    ports:
      - "9092:1337"
    environment:
      DATABASE_CLIENT: postgres
      DATABASE_HOST: db
      DATABASE_PORT: 5432
      DATABASE_NAME: kanteera
      DATABASE_USERNAME: kanteera
      DATABASE_PASSWORD: 123456